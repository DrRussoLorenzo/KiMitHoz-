MONGODB_URI=mongodb://127.0.0.1:27017/kimithoz
JWT_SECRET=replace-with-a-long-random-secret
PORT=3001
CLIENT_ORIGIN=http://127.0.0.1:3001
# Google Cloud Console: engedélyezd a YouTube Data API v3-at, majd add meg a szerver API-kulcsát.
# Backendhez IP-cím alapján korlátozd; HTTP-referrer korlátozás csak böngészős hívásokhoz használható.
YOUTUBE_API_KEY=
# Spotify-import: create an app at developer.spotify.com/dashboard and add these server-only credentials.
# Register the exact redirect URI below under the app's Redirect URIs.
# For the deployed Render app, set CLIENT_ORIGIN=https://kimithoz.onrender.com and
# SPOTIFY_REDIRECT_URI=https://kimithoz.onrender.com/api/music/spotify/callback in Render Environment.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/api/music/spotify/callback
# Cloudinary image storage (set either CLOUDINARY_URL or all three values below).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternative: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Induláskor létrejön az egyetlen admin fiók, ha még nincs ilyen.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=Admin123!
ADMIN_USERNAME=admin
ADMIN_NICKNAME=Admin
