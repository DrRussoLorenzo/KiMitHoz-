MONGODB_URI=mongodb://127.0.0.1:27017/kimithoz
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
CLIENT_ORIGIN=http://localhost:3000
# Cloudinary image storage (set either CLOUDINARY_URL or all three values below).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternative: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Induláskor létrejön az egyetlen admin fiók, ha még nincs ilyen.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=Admin123!
ADMIN_USERNAME=admin
ADMIN_NICKNAME=Admin
